# BenchCAD secrets — copy to `.env` and fill in the keys for the providers you use.
# Benchmark data is public; these are only needed to call the models you evaluate.
# A model name routes to a provider automatically (gpt-* -> OpenAI, claude-* ->
# Anthropic, gemini-* -> Gemini, everything else -> OpenRouter).

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
